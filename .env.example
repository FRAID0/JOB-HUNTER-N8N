# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ALLOWED_CHAT_IDS=your_telegram_chat_id_here

# Local worker API protection
WORKER_API_TOKEN=generate_a_long_random_token_here

# n8n data encryption key (keep only in local .env)
N8N_ENCRYPTION_KEY=generate_a_long_random_key_here
N8N_WEBHOOK_TOKEN=generate_a_long_random_webhook_token_here
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/update-job-status

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Candidate Profile Overrides (Optional)
CANDIDATE_EMAIL=your_email@example.com
CANDIDATE_PHONE=+49 170 0000000
LINKEDIN_URL=https://www.linkedin.com/in/your-profile
